# Copy this file to ".env" and fill in your own values.
# NEVER upload the real .env file to GitHub.

# Port for local development (Render sets its own PORT automatically)
PORT=5000

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# Replace <password> with your database user's password, and keep "/amarelaka" as the database name.
MONGODB_URI=mongodb+srv://amarelaka_user:<password>@cluster0.xxxxx.mongodb.net/amarelaka?retryWrites=true&w=majority

# A long random secret used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Reports within this many metres, of the same category, are suggested as duplicates
NEARBY_METERS=100

# Only needed if the frontend is hosted on a DIFFERENT domain than the backend
# (comma-separated list). Leave empty when the backend serves the frontend.
CORS_ORIGIN=

# Used by "npm run create-admin" to create the first admin account
ADMIN_NAME=Ratul Hasan
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
